MMAX_HOST=0.0.0.0
MMAX_PORT=6006

MMAX_API_KEY_FILE=/root/autodl-tmp/mmax/.api_key
# MMAX_API_KEY=

# 可选覆盖项。默认使用 mmax 自己的 Python 环境和 DiffSynth 目录。
# MMAX_PYTHON_BIN=/root/autodl-tmp/mmax/.venv/bin/python
# MMAX_DIFFSYNTH_PATH=/root/autodl-tmp/mmax/.deps/DiffSynth-Studio

MMAX_DATA_DIR=/root/autodl-tmp
# install.sh 会检查 MMAX_DATA_DIR 是否为独立挂载点（数据盘）。
# 未挂载数据盘时默认中止，避免把 ≈28GB 权重静默写进 30G 系统盘；
# 确知要用系统盘或处于非 AutoDL 环境时，取消注释以跳过检查。
# MMAX_ALLOW_NO_DATA_DISK=1

# 依赖安装策略（install.sh）。默认复用镜像自带 torch，并安装 diffsynth 的 [audio] extra。
# MMAX_VENV_SYSTEM_SITE=1  # venv 用 --system-site-packages 复用镜像 torch；设 0 用隔离 venv（会重下 torch ≈3.6GB）
# MMAX_DIFFSYNTH_EXTRAS=audio  # diffsynth 的 extras；H3 后端需要 [audio]（av / torchaudio）
# MMAX_DIFFSYNTH_CONSTRAINTS='transformers<5'  # 追加版本约束；复用镜像 torch 时脚本会自动加 torch==<镜像版本> 防止连带升级
#   该值必须用引号包裹：.env 会被 install.sh `source`，未加引号的 < 会被 bash 当成输入重定向，
#   使上界被静默截断成无约束的 transformers。多个约束用空格分隔，整体加引号。
# MMAX_PIP_NO_CACHE=1  # 安装期不保留 pip 缓存（默认保留以便失败重试，安装成功后统一 purge）

MMAX_OUTPUT_DIR=/root/autodl-tmp/outputs
MMAX_RUNTIME_DIR=/root/autodl-tmp/mmax/runtime

MMAX_H3_ENABLED=true
MMAX_H3_MODEL_ID=minimax-h3
MMAX_H3_DIT=/root/autodl-tmp/models/h3/DiffSynth-Studio/MiniMax-H3-NF4/minimax-h3-fl2va-pruned-nf4.safetensors
MMAX_H3_TEXT_ENCODER=/root/autodl-tmp/models/h3/DiffSynth-Studio/MiniMax-H3-NF4/minimax-h3-text-encoder-nf4.safetensors
MMAX_H3_VIDEO_VAE=/root/autodl-tmp/models/h3/DiffSynth-Studio/MiniMax-H3-NF4/video_vae_nf4.safetensors
MMAX_H3_AUDIO_VAE=/root/autodl-tmp/models/h3/DiffSynth-Studio/MiniMax-H3-NF4/audio_vae_nf4.safetensors
MMAX_H3_PROCESSOR=/root/autodl-tmp/models/h3/MiniMaxAI/MiniMax-H3/FL2VA/processor
# 官方同款 NF4 Pruned FL2VA 示例为 50 steps；默认 20 用于兼顾速度和清晰度。
MMAX_H3_STEPS=20
MMAX_H3_VRAM_RESERVE_GB=4
MMAX_H3_CRF=18
MMAX_H3_SHARPEN=0.35

MMAX_HIDREAM_ENABLED=true
MMAX_HIDREAM_MODEL_ID=hidream-o1-image
MMAX_HIDREAM_DIR=/root/autodl-tmp/models/hidream-o1-image
# HiDream-O1-Image Full / DiffSynth 推荐默认参数。
MMAX_HIDREAM_STEPS=50
MMAX_HIDREAM_CFG_SCALE=4.0
MMAX_HIDREAM_SHIFT=3.0
# 多参考主体驱动默认使用 shift=1。
MMAX_HIDREAM_SUBJECT_SHIFT=1.0
MMAX_HIDREAM_NOISE_SCALE=8.0
# 测试阶段尽量利用显存；如与其他程序共享 GPU，可提高该值。
MMAX_HIDREAM_VRAM_RESERVE_GB=0.5
# 最大 2048x2048，总像素约 4MP；宽高仍需为 16 的倍数。
MMAX_HIDREAM_MAX_PIXELS=4194304
# 官方示例展示最多 10 张多参考图片。
MMAX_HIDREAM_MAX_REFERENCE_IMAGES=10
# 每次图片任务结束后主动卸载权重，确保 H3 能获得完整显存。
MMAX_HIDREAM_RELEASE_VRAM_AFTER_JOB=true

MMAX_MAX_INPUT_IMAGE_BYTES=20971520
