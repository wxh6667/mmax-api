# AutoDL SSH 入口（实例详情里的登录命令）
SSH_REMOTE_USER=root
SSH_REMOTE_HOST=connect.nmb2.seetacloud.com
SSH_REMOTE_PORT=35554

# AutoDL 主机上的 mmax-api（SSH -L 的目标，从 AutoDL 视角解析）
TARGET_HOST=127.0.0.1
TARGET_PORT=6006

# 隧道在 compose 网络内监听的端口
LOCAL_PORT=6006

# Caddy 对外域名（A 记录指向本机，80/443 放行）；纯 HTTP 测试可写 :8080
API_DOMAIN=api.example.com
